// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SECURITY
  WAREHOUSE
  QC
}

enum ProcessType {
  GBB
  GBJ
  GSP
}

enum CargoProcessType {
  INBOUND
  OUTBOUND
}

enum WeighbridgeType {
  IN
  OUT
}

enum WarehouseUnit {
  KG
  PCS
  BAG
  ROLL
  PALLET
}

enum WarehouseCondition {
  GOOD
  DAMAGED
  HOLD
  PARTIAL
  OTHER
}

enum TransactionStatus {
  REGISTERED
  WEIGH_IN_DONE
  QC_VEHICLE_PENDING
  QC_VEHICLE_IN_PROGRESS
  QC_VEHICLE_PASSED
  QC_VEHICLE_REJECTED
  WAREHOUSE_IN_PROGRESS
  WAREHOUSE_DONE
  INCOMING_CHECK_PENDING
  INCOMING_CHECK_IN_PROGRESS
  INCOMING_CHECK_PASSED
  INCOMING_CHECK_REJECTED
  WEIGH_OUT_DONE
  COMPLETED
  CANCELLED
}

enum QcType {
  VEHICLE_CHECK
  INCOMING_CHECK
}

enum QcResult {
  PASS
  REJECT
}

enum CheckResult {
  PASS
  REJECT
  NA
}

enum AttachmentType {
  PHOTO
  DOCUMENT
  SAMPLE
  OTHER
}

enum RiskLevel {
  PENDING_DATA
  SAFE
  WARNING
  CRITICAL
  INVALID_DATA
}

enum CorrectionTargetModule {
  TRANSACTION
  WEIGHBRIDGE
  QC_VEHICLE
  QC_MATERIAL
  INCOMING_MATERIAL
  WAREHOUSE
  STATUS
  ATTACHMENT
  REMARK
}

enum CorrectionAction {
  CORRECT_DATA
  CORRECT_RECORDED_STATUS
  REOPEN_WORKFLOW
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  username                   String    @unique
  passwordHash               String    @map("password")
  name                       String
  role                       Role
  isActive                   Boolean   @default(true)
  refreshTokenHash           String?
  lastLoginAt                DateTime?
  mustChangePassword         Boolean   @default(false)
  passwordChangedAt          DateTime?
  temporaryPasswordExpiresAt DateTime?
  tokenVersion               Int       @default(0)
  isDeleted                  Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  phone                      String?
  department                 String?
  site                       String?
  area                       String?
  avatarUrl                  String?

  warehouseAccess           UserWarehouseAccess[]
  activityLogs              ActivityLog[]
  weighInTransactions       Transaction[]           @relation("WeighInByUser")
  weighOutTransactions      Transaction[]           @relation("WeighOutByUser")
  warehouseStartedProcesses WarehouseProcess[]      @relation("WarehouseStartBy")
  warehouseEndedProcesses   WarehouseProcess[]      @relation("WarehouseEndBy")
  txWarehouseStarted        Transaction[]           @relation("TxWarehouseStartBy")
  txWarehouseEnded          Transaction[]           @relation("TxWarehouseEndBy")
  qcVehicleChecks           QcVehicleCheck[]        @relation("QCVehicleCheckedBy")
  incomingChecks            IncomingMaterialCheck[] @relation("IncomingCheckedBy")
  uploadedAttachments       Attachment[]            @relation("UploadedBy")
  acknowledgedFrauds        FraudCheck[]            @relation("AcknowledgedBy")
  systemIssues              SystemIssue[]
  transactionCorrections    TransactionCorrection[]
}

model UserWarehouseAccess {
  id          String      @id @default(uuid())
  userId      String
  processType ProcessType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, processType])
}

model Transaction {
  id                    String            @id @default(uuid())
  transactionNumber     String            @unique
  plateNumber           String
  driverName            String
  driverPhone           String
  vendorName            String
  vehicleType           String
  processType           ProcessType
  cargoType             String
  cargoSubType          String?
  cargoProcessType      CargoProcessType
  suratJalanNumber      String?
  poNumber              String?
  permitCardNumber      String?
  guestIdNumber         String?
  status                TransactionStatus @default(REGISTERED)
  gateInAt              DateTime?
  gateOutAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdById           String?
  cancelledById         String?
  remarks               String?
  grossWeight           Float?
  tareWeight            Float?
  netWeight             Float?
  weighInAt             DateTime?
  weighOutAt            DateTime?
  weighInById           String?
  weighOutById          String?
  warehouseStartAt      DateTime?
  warehouseEndAt        DateTime?
  warehouseStartById    String?
  warehouseEndById      String?
  actualWeight          Float?
  actualQuantity        Int?
  warehouseUnit         WarehouseUnit?
  qcStartAt             DateTime?
  qcEndAt               DateTime?
  qcAnalysisCompleted   Boolean           @default(false)
  qcAnalysisCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revision  Int      @default(1)

  weighInBy              User?                      @relation("WeighInByUser", fields: [weighInById], references: [id], onDelete: SetNull)
  weighOutBy             User?                      @relation("WeighOutByUser", fields: [weighOutById], references: [id], onDelete: SetNull)
  warehouseStartBy       User?                      @relation("TxWarehouseStartBy", fields: [warehouseStartById], references: [id], onDelete: SetNull)
  warehouseEndBy         User?                      @relation("TxWarehouseEndBy", fields: [warehouseEndById], references: [id], onDelete: SetNull)
  statusHistory          TransactionStatusHistory[]
  weighbridgeRecords     WeighbridgeRecord[]
  warehouseProcesses     WarehouseProcess[]
  qcVehicleChecks        QcVehicleCheck[]
  incomingMaterialChecks IncomingMaterialCheck[]
  fraudChecks            FraudCheck[]
  attachments            Attachment[]
  corrections            TransactionCorrection[]

  @@index([status])
  @@index([plateNumber])
  @@index([processType, status])
  @@index([createdAt])
}

model TransactionStatusHistory {
  id            String             @id @default(uuid())
  transactionId String
  oldStatus     TransactionStatus?
  newStatus     TransactionStatus
  changedById   String?
  notes         String?
  changedAt     DateTime           @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model WeighbridgeRecord {
  id            String          @id @default(uuid())
  transactionId String
  type          WeighbridgeType
  weight        Float
  ticketNumber  String?
  operatorId    String?
  remarks       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, type])
}

model WarehouseProcess {
  id             String              @id @default(uuid())
  transactionId  String
  processType    ProcessType
  startAt        DateTime?
  endAt          DateTime?
  startById      String?
  endById        String?
  actualWeight   Float?
  actualQuantity Int?
  unit           WarehouseUnit?
  palletCount    Int?
  bagCount       Int?
  rollCount      Int?
  condition      WarehouseCondition?
  remarks        String?
  checklistItems Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  startBy     User?       @relation("WarehouseStartBy", fields: [startById], references: [id], onDelete: SetNull)
  endBy       User?       @relation("WarehouseEndBy", fields: [endById], references: [id], onDelete: SetNull)

  @@unique([transactionId, processType])
  @@index([transactionId])
}

model QcVehicleCheck {
  id                   String       @id @default(uuid())
  transactionId        String       @unique
  result               QcResult?
  vehicleCleanliness   CheckResult?
  vehicleOdor          CheckResult?
  pestEvidence         CheckResult?
  vehicleCondition     CheckResult?
  documentCompleteness CheckResult?
  sealCondition        CheckResult?
  notes                String?
  checklistItems       Json?
  checkedById          String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  checkedBy   User?       @relation("QCVehicleCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([transactionId])
}

model IncomingMaterialCheck {
  id                 String       @id @default(uuid())
  transactionId      String       @unique
  result             QcResult?
  odor               CheckResult?
  color              CheckResult?
  moisture           Float?
  foreignMatter      Float?
  beanCondition      CheckResult?
  sampleWeight       Float?
  goodBeanPercentage Float?
  itemCondition      CheckResult?
  packagingCondition CheckResult?
  quantityCheck      CheckResult?
  documentCheck      CheckResult?
  visualInspection   CheckResult?
  defectNotes        String?
  notes              String?
  checklistItems     Json?
  checkedById        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  checkedBy   User?       @relation("IncomingCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([transactionId])
}

model Attachment {
  id             String         @id @default(uuid())
  transactionId  String
  module         String
  attachmentType AttachmentType
  originalName   String
  fileName       String
  filePath       String
  mimeType       String
  size           Int
  description    String?
  uploadedById   String?
  createdAt      DateTime       @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([transactionId])
}

model FraudCheck {
  id                     String    @id @default(uuid())
  transactionId          String
  netWeight              Float?
  warehouseActualWeight  Float?
  deviationKg            Float?
  deviationPercent       Float?
  riskLevel              RiskLevel
  riskReason             String?
  isAcknowledged         Boolean   @default(false)
  acknowledgedById       String?
  acknowledgedAt         DateTime?
  acknowledgementRemarks String?
  calculatedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  acknowledgedBy User?       @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([transactionId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  role        String?
  action      String
  module      String
  description String?
  referenceId String?
  status      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([module, action])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnnouncementType {
  INFO
  WARNING
  FRAUD_ALERT
  CRITICAL
}

enum AnnouncementStatus {
  ACTIVE
  INACTIVE
}

enum AnnouncementLocation {
  ALL_PAGES
  DASHBOARD
  GATE
  WEIGHBRIDGE
  WAREHOUSE
  QC
}

enum AnnouncementSpeed {
  SLOW
  NORMAL
  FAST
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

model Announcement {
  id              String               @id @default(uuid())
  title           String
  message         String
  type            AnnouncementType     @default(INFO)
  status          AnnouncementStatus   @default(ACTIVE)
  location        AnnouncementLocation @default(ALL_PAGES)
  speed           AnnouncementSpeed    @default(NORMAL)
  startDate       DateTime?
  endDate         DateTime?
  textColor       String?
  backgroundColor String?
  priority        AnnouncementPriority @default(MEDIUM)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       String?
  updatedBy       String?
}

model SystemIssue {
  id            String   @id @default(uuid())
  issueType     String
  description   String
  screenshotUrl String?
  status        String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  reporterId    String
  reporter      User     @relation(fields: [reporterId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TransactionCorrection {
  id               String           @id @default(uuid())
  transactionId    String
  correctedById    String
  correctionNumber String           @unique @default(uuid())
  action           CorrectionAction @default(CORRECT_DATA)
  reasonCode       String           @default("OTHER")
  reason           String
  remark           String           @default("")
  evidenceUrl      String?
  oldValues        Json
  newValues        Json
  expectedRevision Int              @default(1)
  ipAddress        String?
  createdAt        DateTime         @default(now())

  transaction      Transaction                 @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  correctedBy      User                        @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  items            TransactionCorrectionItem[]

  @@index([transactionId])
  @@index([correctedById])
  @@index([correctionNumber])
}

model TransactionCorrectionItem {
  id             String                 @id @default(uuid())
  correctionId   String
  targetModule   CorrectionTargetModule
  targetRecordId String?
  fieldName      String
  oldValue       Json?
  newValue       Json?
  itemRemark     String?
  createdAt      DateTime               @default(now())

  correction     TransactionCorrection  @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@index([correctionId])
  @@index([targetModule, targetRecordId])
}
