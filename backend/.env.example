# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gms?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gms

# App Port
PORT=3001

# Environment mode (development / production)
NODE_ENV=development

# CORS setting, required for frontend communication
CORS_ORIGIN=http://localhost:8081

# JWT Settings - MUST BE GENERATED AS 32+ BYTE RANDOM HEX KEYS IN PRODUCTION!
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_NEVER_USE_THIS_PLACEHOLDER_ACCESS_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_NEVER_USE_THIS_PLACEHOLDER_REFRESH_KEY"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Default Seed Passwords (Must be changed upon initial setup)
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_MUST_BE_COMPLEX
DEFAULT_QC_PASSWORD=CHANGE_ME_QC_MUST_BE_COMPLEX
DEFAULT_WAREHOUSE_PASSWORD=CHANGE_ME_WAREHOUSE_MUST_BE_COMPLEX
DEFAULT_SECURITY_PASSWORD=CHANGE_ME_SECURITY_MUST_BE_COMPLEX
